# Copy this file to `.env.local` and fill in the values from your Supabase
# project (Dashboard → Project Settings → API). Do NOT commit `.env.local`.

# Project URL — e.g. https://abcdefghijklmnopqrst.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Project "anon" / public API key. Safe to expose in the browser.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Used only by administrative tooling; never referenced by the
# browser and never prefixed with NEXT_PUBLIC_. Optional — the app works
# without it, and only RLS-authorized users can write through the anon key.
SUPABASE_SERVICE_ROLE_KEY=
